{
  "name": "stumblestone-site",
  "private": true,
  "version": "0.1.0",
  "description": "GitHub Pages organization site for StumbleStone.",
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "11.8.0"
  },
  "scripts": {
    "dev": "pnpm serve",
    "serve": "webpack-dev-server --config webpack.config.ts --mode development",
    "build": "webpack --config webpack.config.ts --mode production",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@fortawesome/fontawesome-svg-core": "7.2.0",
    "@fortawesome/free-brands-svg-icons": "7.1.0",
    "@fortawesome/free-solid-svg-icons": "7.2.0",
    "@fortawesome/react-fontawesome": "3.3.1",
    "@stumblestone/components": "1.0.0",
    "@stumblestone/project-bookinator": "1.0.0",
    "@stumblestone/refdown-ui": "1.0.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router-dom": "7.13.0"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/node": "26.0.0",
    "css-loader": "7.1.3",
    "html-webpack-plugin": "5.6.7",
    "prettier": "3.8.4",
    "style-loader": "4.0.0",
    "ts-loader": "9.6.1",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "webpack": "5.107.2",
    "webpack-cli": "7.0.3",
    "webpack-dev-server": "5.2.4"
  }
}
